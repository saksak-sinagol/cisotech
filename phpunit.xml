<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Cisotech application">
            <directory>tests</directory>
            <exclude>tests/integration</exclude>
            <exclude>tests/e2e</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>includes/auth.php</file>
            <file>includes/config.php</file>
            <file>includes/error_handling.php</file>
            <file>includes/http_security.php</file>
            <file>includes/deployment_rules.php</file>
            <file>includes/inventory_rules.php</file>
            <file>includes/spec_schema.php</file>
        </include>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout" showUncoveredFiles="true" showOnlySummary="false"/>
        </report>
    </coverage>
</phpunit>
